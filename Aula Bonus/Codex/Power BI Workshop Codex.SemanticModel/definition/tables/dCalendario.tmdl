	partition dCalendario = m
		mode: import
		source = ```
				let
				    hojeBrasil = Date.From(DateTimeZone.SwitchZone(DateTimeZone.UtcNow(), -3)),
				    dataInicio = Date.StartOfYear(dataInicial),
				    dataFim = Date.EndOfYear(hojeBrasil),
				    dias = Duration.Days(dataFim - dataInicio) + 1,
				    listarDatas = List.Dates(dataInicio, dias, #duration(1,0,0,0)),
				    tabela = #table(
				        type table[
				            Data = date,
				            Dia = Int64.Type,
				            Ano = Int64.Type,
				            NomeMes = text,
				            MesAbre = text,
				            MesAno = text,
				            MesNum = Int64.Type,
				            AnoMesInt = Int64.Type,
				            Trimestre = Int64.Type,
				            TrimestreAbreviado = text,
				            Bimestre = text,
				            Semestre = text,
				            Semana = Int64.Type,
				            DiaSemana = Int64.Type,
				            NomeDia = text,
				            EhDiaAtual = Logical.Type,
				            EhMesAtual = Logical.Type,
				            EhAnoAtual = Logical.Type,
				            MesAtual = text,
				            AnoAtual = text
				            
				
				        ],
				        List.Transform(
				            listarDatas,
				            each {
				                _,
				                Date.Day(_),
				                Date.Year(_),
				                Text.Proper( Date.MonthName(_)),
				                Text.Proper(Text.Start(Date.MonthName(_), 3)),
				                Text.Proper(Text.Start(Date.MonthName(_), 3)) & "-" & Text.End(Text.From(Date.Year(_)), 2),
				                Date.Month(_),
				                Date.Year(_) * 100 + Date.Month(_),
				                Date.QuarterOfYear(_),
				                Text.From(Date.QuarterOfYear(_)) & "º Trim ",
				                Text.From( Number.RoundUp( Date.Month(_)/2,0)) & "º Bim",
				                Text.From( Number.RoundUp( Date.Month(_)/6,0)) & "º Sem",
				                Date.WeekOfMonth(_),
				                Date.DayOfWeek(_),
				                Date.DayOfWeekName(_),
				                _ = hojeBrasil,
				                Date.Month(_) = Date.Month(hojeBrasil) and Date.Year(_) = Date.Year(hojeBrasil),
				                Date.Year(_) = Date.Year(hojeBrasil),
				                if Date.Month(_) = Date.Month(hojeBrasil) and Date.Year(_) = Date.Year(hojeBrasil) then "Mês Atual" else Text.Proper(Text.Start(Date.MonthName(_), 3)),
				                if Date.Year(_) = Date.Year(hojeBrasil) then "Ano Atual" else Text.From(Date.Year(_))
				                
				
				            }
				
				        )
				    )
				in
				    tabela
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

