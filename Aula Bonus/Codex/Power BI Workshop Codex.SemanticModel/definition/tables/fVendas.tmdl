	partition fVendas = m
		mode: import
		source =
				let
				  origem = srcVendasExemplo,
				  navegacao = origem{[Item = "Vendas", Kind = "Sheet"]}[Data],
				  cabecalhosPromovidos = Table.PromoteHeaders(navegacao, [PromoteAllScalars = true]),
				  tiposAjustados = Table.TransformColumnTypes(cabecalhosPromovidos, {{"ID_Venda", type text}, {"Data", type date}, {"ID_Cliente", type text}, {"ID_Produto", type text}, {"Quantidade", Int64.Type}, {"Preço_Unitário", type number}, {"Valor_Total", type number}, {"Forma_Pagamento", type text}, {"Status", type text}}),
				  mergeCliente = Table.NestedJoin(tiposAjustados, {"ID_Cliente"}, dCliente, {"ClienteId"}, "cliente", JoinKind.LeftOuter),
				  expandeLocal = Table.ExpandTableColumn(mergeCliente, "cliente", {"LocalId"}, {"LocalId"}),
				  colunasRenomeadas = Table.RenameColumns(expandeLocal, {{"ID_Venda", "VendaId"}, {"ID_Cliente", "ClienteId"}, {"ID_Produto", "ProdutoId"}, {"Preço_Unitário", "PrecoUnitario"}, {"Valor_Total", "ValorTotal"}, {"Forma_Pagamento", "FormaPagamento"}})
				in
				  colunasRenomeadas

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

