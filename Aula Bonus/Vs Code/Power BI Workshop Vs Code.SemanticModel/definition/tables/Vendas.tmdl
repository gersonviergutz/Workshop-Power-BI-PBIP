	partition Vendas = m
		mode: import
		source =
				let
				  pCaminhoArquivoVendas = "C:\Users\gerso\OneDrive - Minhas Planilhas\Minhas Planilhas\Comunidade Dashmaker\Cursos\Workshop Power BI na era da IA Generativa\Material Workshop\Banco de Dados\Vendas Exemplo.xlsx",
				  origemArquivo = Excel.Workbook(File.Contents(pCaminhoArquivoVendas), null, true),
				  abaVendas = origemArquivo{[Item = "Vendas", Kind = "Sheet"]}[Data],
				  cabecalhosPromovidos = Table.PromoteHeaders(abaVendas, [PromoteAllScalars = true]),
				  tiposAjustados = Table.TransformColumnTypes(cabecalhosPromovidos, {{"ID_Venda", type text}, {"Data", type date}, {"ID_Cliente", type text}, {"ID_Produto", type text}, {"Quantidade", Int64.Type}, {"Preço_Unitário", type number}, {"Valor_Total", type number}, {"Forma_Pagamento", type text}, {"Status", type text}})
				in
				  tiposAjustados

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

